{
  "name": "markdown-ultimate",
  "displayName": "Markdown Ultimate",
  "description": "The ultimate markdown editor for VS Code — toggle source/preview in the same tab, KaTeX math, Mermaid diagrams, emoji, task lists, TOC, and export to HTML/PDF/PNG.",
  "version": "0.4.1",
  "publisher": "piwa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/piiwa/markdown-ultimate"
  },
  "bugs": {
    "url": "https://github.com/piiwa/markdown-ultimate/issues"
  },
  "homepage": "https://github.com/piiwa/markdown-ultimate#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "mermaid",
    "katex",
    "pdf",
    "all-in-one",
    "editor",
    "export",
    "latex",
    "toggle"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Preview and editing work everywhere. Direct PDF/PNG export launches a browser binary, so the markdownToggle.chromePath setting is only honored in trusted workspaces.",
      "restrictedConfigurations": [
        "markdownToggle.chromePath"
      ]
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Markdown Ultimate",
      "properties": {
        "markdownToggle.defaultMode": {
          "type": "string",
          "enum": [
            "source",
            "preview"
          ],
          "enumDescriptions": [
            "Open markdown files in the source editor",
            "Open markdown files in the rendered preview"
          ],
          "default": "source",
          "description": "Which mode a markdown file opens in."
        },
        "markdownToggle.chromePath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "markdownDescription": "Absolute path to a Chrome/Chromium executable used for direct PDF/PNG export. Leave empty to auto-detect. Machine-scoped for security: a workspace cannot override it."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "markdownToggle.editor",
        "displayName": "Markdown Ultimate Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markdownToggle.showPreview",
        "title": "Show Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownToggle.showSource",
        "title": "Show Markdown Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdownToggle.toggleBold",
        "title": "Markdown: Toggle Bold"
      },
      {
        "command": "markdownToggle.toggleItalic",
        "title": "Markdown: Toggle Italic"
      },
      {
        "command": "markdownToggle.toggleStrikethrough",
        "title": "Markdown: Toggle Strikethrough"
      },
      {
        "command": "markdownToggle.headingUp",
        "title": "Markdown: Increase Heading Level"
      },
      {
        "command": "markdownToggle.headingDown",
        "title": "Markdown: Decrease Heading Level"
      },
      {
        "command": "markdownToggle.toggleCheckbox",
        "title": "Markdown: Toggle Checkbox"
      },
      {
        "command": "markdownToggle.openWith",
        "title": "Markdown Ultimate: Open With This Editor"
      }
    ],
    "keybindings": [
      {
        "command": "markdownToggle.toggleBold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "markdownToggle.active && markdownToggle.mode == source"
      },
      {
        "command": "markdownToggle.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "markdownToggle.active && markdownToggle.mode == source"
      },
      {
        "command": "markdownToggle.toggleStrikethrough",
        "key": "alt+s",
        "when": "markdownToggle.active && markdownToggle.mode == source"
      },
      {
        "command": "markdownToggle.headingUp",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "markdownToggle.active && markdownToggle.mode == source"
      },
      {
        "command": "markdownToggle.headingDown",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "markdownToggle.active && markdownToggle.mode == source"
      },
      {
        "command": "markdownToggle.toggleCheckbox",
        "key": "alt+c",
        "when": "markdownToggle.active && markdownToggle.mode == source"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.md": "markdownToggle.editor",
        "*.markdown": "markdownToggle.editor"
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "markdownToggle.showPreview",
          "group": "navigation",
          "when": "markdownToggle.active && markdownToggle.mode != preview"
        },
        {
          "command": "markdownToggle.showSource",
          "group": "navigation",
          "when": "markdownToggle.active && markdownToggle.mode == preview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm typecheck && node esbuild.config.mjs",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "npx @vscode/vsce package --no-dependencies",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "katex": "^0.16.47",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "markdown-it-toc-done-right": "^4.2.0",
    "mermaid": "^11.16.1",
    "puppeteer-core": "^24.43.1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
